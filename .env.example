# Скопируйте этот файл в .env и заполните значения:
#   Windows (PowerShell 7): Copy-Item .env.example .env
#   Linux, macOS:           cp .env.example .env
# Пароли в репозиторий не коммитятся, здесь только заглушки.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=test

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_DB=test

# Airflow
AIRFLOW_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_JWT_SECRET=change_me

# Dagster
# DAGSTER_HOST и DAGSTER_PORT — адрес UI при подключении с хоста.
# Metadata DB DAGSTER_DB создаётся автоматически; доступ к ней — под POSTGRES_USER.
DAGSTER_HOST=localhost
DAGSTER_PORT=13000
DAGSTER_DB=dagster

# dbt
DBT_POSTGRES_SCHEMA=dbt
DBT_CLICKHOUSE_SCHEMA=dbt

# Superset
# SUPERSET_SECRET_KEY — случайная строка не короче 42 символов; дефолтное значение
# Superset (CHANGE_ME_TO_A_COMPLEX_RANDOM_SECRET) запрещено: контейнер не стартует.
# Metadata DB SUPERSET_DB создаётся автоматически; доступ к ней — под POSTGRES_USER.
SUPERSET_DB=superset
SUPERSET_SECRET_KEY=change_me_change_me_change_me_change_me_change_me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_ADMIN_EMAIL=admin@example.com
